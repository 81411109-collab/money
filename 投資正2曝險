                        </div>
                        <div style="background: var(--bg-body); padding: 12px; border-radius: 10px; border: 1px solid var(--border-color);">
                            <div style="font-size: 11px; color: var(--text-secondary); margin-bottom: 4px;">目前估算損益</div>
                            <div style="font-size: 18px; font-weight: 700;" class="text-cash" id="analysis-net-profit">+$0</div>
                        </div>
                        <div style="background: var(--bg-body); padding: 12px; border-radius: 10px; border: 1px solid var(--border-color);">
                            <div style="font-size: 11px; color: var(--text-secondary); margin-bottom: 4px;">估算報酬率</div>
                            <div style="font-size: 18px; font-weight: 700;" class="text-cash" id="analysis-return-rate">0.00%</div>
                        </div>
                        <div style="background: var(--bg-body); padding: 12px; border-radius: 10px; border: 1px solid var(--border-color);">
                            <div style="font-size: 11px; color: var(--text-secondary); margin-bottom: 4px;">歷史節點數</div>
                            <div style="font-size: 18px; font-weight: 700; color: #fbbf24;" id="analysis-max-profit">0</div>
                        </div>
                    </div>

                    <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 8px; text-align: center;">
                        📊 歷史資產記帳追蹤曲線
                    </div>
                    <div class="chart-box">
                        <canvas id="mixedHistoryChart" style="height: 220px; width: 100%;"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="tab-cash" class="tab-content">
        <div class="panel-block" style="max-width: 600px; margin: 0 auto;">
            <div class="panel-heading"><i class="fa-solid fa-wallet text-cash"></i> 現金存款即時更新調整</div>
            <div class="input-wrapper" style="margin-bottom: 20px;">
                <label for="direct-cash-input" style="font-size: 14px;">設定現金存款總額 (新台幣元)</label>
                <input type="number" id="direct-cash-input" class="form-control" style="font-size: 16px; padding: 12px;" oninput="syncParamsFromTabs()">
            </div>
            <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.6;">
                * 說明：在此處修改或填入您的最新現金部位後，系統整體的「資產組成比例」、「總資產」與「淨資產」將會在各個分頁中同步動態連動。
            </p>
        </div>
    </div>

    <div id="tab-debt" class="tab-content">
        <div class="panel-block" style="max-width: 600px; margin: 0 auto;">
            <div class="panel-heading"><i class="fa-solid fa-building-columns text-debt"></i> 信貸負債金額更新調整</div>
            <div class="input-wrapper" style="margin-bottom: 20px;">
                <label for="direct-debt-input" style="font-size: 14px;">設定信貸/總負債金額 (新台幣元)</label>
                <input type="number" id="direct-debt-input" class="form-control" style="font-size: 16px; padding: 12px;" oninput="syncParamsFromTabs()">
            </div>
            <p style="font-size: 13px; color: var(--text-secondary); line-height: 1.6;">
                * 說明：負債金額將會直接影響「負債比」的權重，並從總資產中扣除，實時反應出最真實的「淨資產（身價）」變化。
            </p>
        </div>
    </div>

</div>

<script>
    // 初始數據設定值
    const initialDefaultState = {
        cash: 1284608,
        debt: 3530000,
        stocks: [
            { 
                name: "00631L", 
                shares: 36000, 
                price: 39.22, 
                historyPrices: [34.40, 35.73, 34.47, 36.94, 37.78, 37.91, 39.22],
                historyProfits: [-13000, 95000, 210000, 758311, 1010000, 1050000, 1450363]
            },
            { 
                name: "00685L", 
                shares: 12000, 
                price: 85.50, 
                historyPrices: [78.2, 80.1, 79.5, 81.4, 83.0, 84.2, 85.5],
                historyProfits: [50000, 85000, 75000, 120000, 150000, 185000, 235000]
            }
        ],
        selectedStockIndex: 0
    };

    let state = {};
    let mixedChartInstance = null;

    function formatMoney(value) {
        return Math.round(value).toLocaleString('zh-TW');
    }

    function formatToWan(value) {
        let isNegative = value < 0;
        let absValue = Math.abs(value);
        let wanStr = (absValue / 10000).toFixed(1) + " 萬";
        return (isNegative ? "-" : "+") + "$" + wanStr;
    }
    
    function formatToWanNormal(value) {
        let isNegative = value < 0;
        let absValue = Math.abs(value);
        let wanStr = (absValue / 10000).toFixed(1) + " 萬";
        return (isNegative ? "-" : "") + "$" + wanStr;
    }

    function appInit() {
        const stored = localStorage.getItem('ultra_portfolio_state_v4');
        if (stored) {
            try {
                state = JSON.parse(stored);
            } catch(e) {
                state = JSON.parse(JSON.stringify(initialDefaultState));
            }
        } else {
            state = JSON.parse(JSON.stringify(initialDefaultState));
        }

        document.getElementById('direct-cash-input').value = state.cash;
        document.getElementById('direct-debt-input').value = state.debt;

        refreshAppEngine();
    }

    function switchMainTab(event, tabId) {
        const tabs = document.querySelectorAll('.nav-tab');
        const contents = document.querySelectorAll('.tab-content');
        
        tabs.forEach(t => t.classList.remove('active'));
        contents.forEach(c => c.classList.remove('active'));

        event.target.classList.add('active');
        document.getElementById(tabId).classList.add('active');
        
        if(tabId === 'tab-stocks') {
            renderMixedChart();
        }
    }

    function syncParamsFromTabs() {
        const cashVal = document.getElementById('direct-cash-input').value;
        const debtVal = document.getElementById('direct-debt-input').value;
        
        state.cash = cashVal ? parseFloat(cashVal) : 0;
        state.debt = debtVal ? parseFloat(debtVal) : 0;
        
        refreshAppEngine();
    }

    function toggleCustomRatioInput() {
        const type = document.getElementById('target-ratio-select').value;
        const wrapper = document.getElementById('custom-ratio-wrapper');
        if(type === 'custom') {
            wrapper.style.display = 'flex';
        } else {
            wrapper.style.display = 'none';
        }
    }

    // ⚡️ 核心：對接台灣證交所 API 一鍵更新今日最新收盤價 ⚡️
    function fetchLatestPricesFromTWSE() {
        const btn = document.getElementById('btn-refresh-prices');
        const originalText = btn.innerHTML;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> 連線台灣證交所中...`;
        btn.disabled = true;

        // 串接證交所每日上市公司與上市ETF收盤價資訊
        fetch('https://openapi.twse.com.tw/v1/exchangeReport/STOCK_DAY_ALL')
            .then(response => {
                if (!response.ok) throw new Error('網路回應異常');
                return response.json();
            })
            .then(data => {
                let successCount = 0;
                
                state.stocks.forEach(st => {
                    const targetCode = st.name.trim().toUpperCase();
                    // 在證交所回傳的幾千個標的中搜尋對應代號
                    const foundObj = data.find(item => item.Code === targetCode);
                    
                    if (foundObj && foundObj.ClosingPrice) {
                        const latestPrice = parseFloat(foundObj.ClosingPrice.replace(/,/g, ''));
                        if (!isNaN(latestPrice) && latestPrice > 0) {
                            st.price = latestPrice;
                            successCount++;
                        }
                    }
                });

                if (successCount > 0) {
                    alert(`🎉 股價同步成功！已為您從台灣證交所下載最新收盤數據，共自動更新 ${successCount} 檔持倉標的最新價格。`);
                    refreshAppEngine();
                } else {
                    alert(`ℹ️ 未找到相符的上市股票代號。請確認您的持倉代號是否正確輸入（如：00631L、0050）。`);
                }
            })
            .catch(error => {
                console.error('API Error:', error);
                alert(`⚠️ 自動更新失敗！可能原因：\n1. 您的瀏覽器目前安全性限制（CORS）阻擋了本機檔案直接存取外網。 (您可以嘗試更換瀏覽器，或將此網頁部署至 GitHub Pages)\n2. 證交所公開資料伺服器目前繁忙中。\n3. 您當前網路中斷。`);
            })
            .finally(() => {
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
    }

    // 🎯 資產曝險再平衡與正2槓桿放大計算引擎
    function runRebalanceEngine() {
        let totalStockMarketValue = 0;
        let totalLeveragedExposure = 0;

        state.stocks.forEach(st => {
            let mktVal = st.shares * st.price;
            totalStockMarketValue += mktVal;
            
            if(st.name.toUpperCase().includes('L') || st.name.includes('正2')) {
                totalLeveragedExposure += (mktVal * 2);
            } else {
                totalLeveragedExposure += mktVal;
            }
        });

        const totalAssets = totalStockMarketValue + state.cash;
        const netWorth = totalAssets - state.debt;

        const exposureRate = netWorth > 0 ? ((totalLeveragedExposure / netWorth) * 100).toFixed(1) : "0.0";
        document.getElementById('real-leverage-exposure').innerText = formatToWanNormal(totalLeveragedExposure) + " (佔淨資產 " + exposureRate + "%)";

        const ratioSelect = document.getElementById('target-ratio-select').value;
        let targetStockPct = 90; 
        if (ratioSelect === '9:1') targetStockPct = 90;
        else if (ratioSelect === '8:2') targetStockPct = 80;
        else if (ratioSelect === '7:3') targetStockPct = 70;
        else if (ratioSelect === 'custom') {
            targetStockPct = parseFloat(document.getElementById('custom-stock-pct').value) || 90;
        }
        
        const targetCashPct = 100 - targetStockPct;
        const targetStockVal = totalAssets * (targetStockPct / 100);
        const targetCashVal = totalAssets * (targetCashPct / 100);

        document.getElementById('rebalance-target-stock').innerText = formatToWanNormal(targetStockVal) + " (" + formatMoney(targetStockVal) + " 元)";
        document.getElementById('rebalance-target-cash').innerText = formatToWanNormal(targetCashVal) + " (" + formatMoney(targetCashVal) + " 元)";

        const stockDiff = targetStockVal - totalStockMarketValue;
        const adviceEl = document.getElementById('rebalance-advice');

        if (Math.abs(stockDiff) < 1000) {
            adviceEl.innerHTML = `<span style="color:var(--color-cash); font-weight:bold;"><i class="fa-solid fa-circle-check"></i> 完美平衡！</span> 目前配置比例完全契合目標設定。`;
        } else if (stockDiff > 0) {
            adviceEl.innerHTML = `<span style="color:var(--color-warning); font-weight:bold;"><i class="fa-solid fa-circle-exclamation"></i> 股票曝險不夠（部位過低）：</span> 建議將現金中的 <span class="text-stock" style="font-weight:700; font-size:15px;">$${formatMoney(stockDiff)} 元</span>（約 ${formatToWanNormal(stockDiff)}）拿去**買入股票**，以達標 ${targetStockPct}:${targetCashPct} 的理想配置。`;
        } else {
            adviceEl.innerHTML = `<span style="color:var(--color-debt); font-weight:bold;"><i class="fa-solid fa-circle-exclamation"></i> 股票曝險過高（部位過大）：</span> 建議**變賣股票**回收 <span class="text-cash" style="font-weight:700; font-size:15px;">$${formatMoney(Math.abs(stockDiff))} 元</span>（約 ${formatToWanNormal(Math.abs(stockDiff))}）轉存為現金，以收回曝險回歸安全界線。`;
        }
    }

    function refreshAppEngine() {
        let totalStockMarketValue = 0;
        let totalStockProfits = 0;
        
        state.stocks.forEach(st => {
            totalStockMarketValue += st.shares * st.price;
            if(st.historyProfits && st.historyProfits.length > 0) {
                totalStockProfits += st.historyProfits[st.historyProfits.length - 1];
            }
        });

        const totalAssets = totalStockMarketValue + state.cash;
        const netWorth = totalAssets - state.debt;
        const debtRatio = totalAssets > 0 ? ((state.debt / totalAssets) * 100).toFixed(1) : "0.0";
        const totalCost = totalStockMarketValue - totalStockProfits;
        const profitPct = totalCost > 0 ? ((totalStockProfits / totalCost) * 100).toFixed(2) : "0.00";

        document.getElementById('view-stock-wan').innerText = formatToWanNormal(totalStockMarketValue);
        document.getElementById('view-stock-raw').innerText = "$" + formatMoney(totalStockMarketValue);

        document.getElementById('view-cash-wan').innerText = formatToWanNormal(state.cash);
        document.getElementById('view-cash-raw').innerText = "$" + formatMoney(state.cash);

        document.getElementById('view-assets-wan').innerText = formatToWanNormal(totalAssets);
        document.getElementById('view-assets-raw').innerText = "$" + formatMoney(totalAssets);

        document.getElementById('view-debt-wan').innerText = formatToWanNormal(state.debt);
        document.getElementById('view-debt-raw').innerText = "$" + formatMoney(state.debt);

        const netWanEl = document.getElementById('view-net-wan');
        netWanEl.innerText = formatToWanNormal(netWorth);
        document.getElementById('view-net-raw').innerText = "$" + formatMoney(netWorth);
        if (netWorth < 0) netWanEl.className = "card-title-main text-debt";
        else netWanEl.className = "card-title-main text-cash";

        const profitWanEl = document.getElementById('view-profit-wan');
        const profitPctEl = document.getElementById('view-profit-pct');
        const rocketIcon = document.getElementById('profit-rocket-icon');
        
        profitWanEl.innerText = formatToWan(totalStockProfits);
        profitPctEl.innerText = (totalStockProfits >= 0 ? "+" : "") + profitPct + "%";
        
        if (totalStockProfits >= 0) {
            profitWanEl.className = "card-title-main text-cash";
            profitPctEl.className = "card-title-sub text-cash";
            rocketIcon.className = "fa-solid fa-rocket text-cash";
        } else {
            profitWanEl.className = "card-title-main text-debt";
            profitPctEl.className = "card-title-sub text-debt";
            rocketIcon.className = "fa-solid fa-arrow-trend-down text-debt";
        }

        const stockPct = totalAssets > 0 ? Math.round((totalStockMarketValue / totalAssets) * 100) : 0;
        const cashPct = totalAssets > 0 ? (100 - stockPct) : 0;
        
        document.getElementById('bar-stock').style.width = stockPct + "%";
        document.getElementById('bar-cash').style.width = cashPct + "%";
        document.getElementById('pct-stock').innerText = stockPct + "%";
        document.getElementById('pct-cash').innerText = cashPct + "%";
        document.getElementById('view-debt-ratio').innerText = "負債比 " + debtRatio + "%";

        buildStockTableList();
        renderDeepAnalysisPanel();
        runRebalanceEngine();

        localStorage.setItem('ultra_portfolio_state_v4', JSON.stringify(state));
    }

    function buildStockTableList() {
        const tbody = document.getElementById('stock-list-tbody');
        tbody.innerHTML = "";

        if (state.stocks.length === 0) {
            tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; color:var(--text-secondary); padding:30px;">目前持倉無任何股票，請於下方表格新增項目。</td></tr>`;
            return;
        }

        state.stocks.forEach((st, index) => {
            const mktVal = st.shares * st.price;
            const tr = document.createElement('tr');
            tr.className = `stock-item-row ${index === state.selectedStockIndex ? 'selected' : ''}`;
            tr.onclick = function() {
                state.selectedStockIndex = index;
                document.querySelectorAll('.stock-item-row').forEach(row => row.classList.remove('selected'));
                tr.classList.add('selected');
                renderDeepAnalysisPanel();
            };

            const isLeveraged = st.name.toUpperCase().includes('L') || st.name.includes('正2');
            const leverageBadge = isLeveraged ? ` <span style="background:rgba(251,191,36,0.15); color:var(--color-warning); font-size:10px; padding:2px 5px; border-radius:4px; border:1px solid rgba(251,191,36,0.3)">2X 槓桿</span>` : '';

            tr.innerHTML = `
                <td><strong>${st.name}</strong>${leverageBadge}</td>
                <td>${formatMoney(st.shares)}</td>
                <td>$${st.price.toFixed(2)}</td>
                <td class="text-stock" style="font-weight:700;">$${formatMoney(mktVal)}</td>
                <td style="text-align:center;" onclick="event.stopPropagation();">
                    <button class="action-delete-btn" onclick="executeDeleteStock(${index})" title="刪除此標的">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    function executeAddStock() {
        const nameIn = document.getElementById('add-stock-name').value.trim();
        const sharesIn = document.getElementById('add-stock-shares').value;
        const priceIn = document.getElementById('add-stock-price').value;

        if(!nameIn || !sharesIn || isNaN(sharesIn) || parseFloat(sharesIn) <= 0 || !priceIn || isNaN(priceIn) || parseFloat(priceIn) <= 0) {
            alert("⚠️ 請填寫正確且完整的標的名稱、股數及價格！");
            return;
        }

        const parsedShares = parseInt(sharesIn);
        const parsedPrice = parseFloat(priceIn);

        const found = state.stocks.find(s => s.name.toUpperCase() === nameIn.toUpperCase());
        if(found) {
            found.shares = parsedShares;
            found.price = parsedPrice;
            found.historyPrices.push(parsedPrice);
            let lastProfit = found.historyProfits[found.historyProfits.length - 1] || 0;
            found.historyProfits.push(lastProfit); 
        } else {
            state.stocks.push({
                name: nameIn.toUpperCase(),
                shares: parsedShares,
                price: parsedPrice,
                historyPrices: [parsedPrice],
                historyProfits: [0]
            });
        }

        document.getElementById('add-stock-name').value = "";
        document.getElementById('add-stock-shares').value = "";
        document.getElementById('add-stock-price').value = "";

        refreshAppEngine();
    }

    function executeDeleteStock(index) {
        if(confirm("確定要移除此股票持倉標的嗎？這將會同步清除其歷史追蹤數據。")) {
            state.stocks.splice(index, 1);
            state.selectedStockIndex = 0;
            refreshAppEngine();
        }
    }

    function renderDeepAnalysisPanel() {
        const currentStock = state.stocks[state.selectedStockIndex];
        
        if(!currentStock) {
            document.getElementById('analysis-stock-title').innerText = "無";
            document.getElementById('analysis-current-price').innerText = "NT$0.00";
            document.getElementById('analysis-net-profit').innerText = "+$0";
            document.getElementById('analysis-return-rate').innerText = "0.00%";
            document.getElementById('analysis-max-profit').innerText = "0";
            if(mixedChartInstance) { mixedChartInstance.destroy(); mixedChartInstance = null; }
            return;
        }

        const lastProfit = currentStock.historyProfits[currentStock.historyProfits.length - 1] || 0;
        const currentMktValue = currentStock.shares * currentStock.price;
        const totalCostPrice = Math.max(1, currentMktValue - lastProfit);
        const returnRate = ((lastProfit / totalCostPrice) * 100).toFixed(2);

        document.getElementById('analysis-stock-title').innerText = currentStock.name;
        document.getElementById('analysis-current-price').innerText = "NT$" + currentStock.price.toFixed(2);
        
        const netProfitEl = document.getElementById('analysis-net-profit');
        netProfitEl.innerText = (lastProfit >= 0 ? "+" : "") + lastProfit.toLocaleString('zh-TW');
        netProfitEl.className = lastProfit >= 0 ? "text-cash" : "text-debt";

        const rateEl = document.getElementById('analysis-return-rate');
        rateEl.innerText = (lastProfit >= 0 ? "+" : "") + returnRate + "%";
        rateEl.className = lastProfit >= 0 ? "text-cash" : "text-debt";

        document.getElementById('analysis-max-profit').innerText = currentStock.historyPrices.length + " 個節點";

        renderMixedChart();
    }

    function renderMixedChart() {
        const currentStock = state.stocks[state.selectedStockIndex];
        const ctx = document.getElementById('mixedHistoryChart');
        if(!currentStock || !ctx) return;

        // 如果節點太少，補充虛擬標籤優化視覺
        const labels = currentStock.historyPrices.map((_, i) => "節點 " + (i + 1));

        if(mixedChartInstance) {
            mixedChartInstance.destroy();
        }

        mixedChartInstance = new Chart(ctx.getContext('2d'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: '歷史股價走勢',
                        data: currentStock.historyPrices,
                        borderColor: '#1ea1f2',
                        backgroundColor: 'rgba(30, 161, 242, 0.1)',
                        borderWidth: 3,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#1ea1f2',
                        pointRadius: 4,
                        fill: true,
                        tension: 0.15
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#111e2e',
                        bodyColor: '#ffffff',
                        borderColor: 'rgba(255,255,255,0.1)',
                        borderWidth: 1,
                        callbacks: {
                            label: function(context) {
                                return ' 收盤價: NT$' + context.raw.toFixed(2);
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#4e6178', font: { size: 10 } } },
                    y: {
                        grid: { color: 'rgba(255,255,255,0.03)' },
                        ticks: {
                            color: '#7b91a9',
                            callback: function(value) { return '$' + value; }
                        }
                    }
                }
            }
        });
    }

    // 📈 實質功能升級：點擊後真正將今日數據存入歷史節點並保存於瀏覽器 📈
    function triggerRecordToday() {
        state.stocks.forEach(st => {
            if (!st.historyPrices) st.historyPrices = [];
            if (!st.historyProfits) st.historyProfits = [];
            
            // 將今日最新股價寫入歷史紀錄
            st.historyPrices.push(st.price);
            
            // 自動滾動推算今日最新損益點
            let lastProfit = st.historyProfits[st.historyProfits.length - 1] || 0;
            let lastPrice = st.historyPrices[st.historyPrices.length - 2] || st.price;
            let impliedCost = (st.shares * lastPrice) - lastProfit;
            let currentProfit = (st.shares * st.price) - impliedCost;
            
            st.historyProfits.push(currentProfit);
            
            // 限制歷史長度（保留最近 30 天，防止儲存空間爆滿）
            if (st.historyPrices.length > 30) {
                st.historyPrices.shift();
                st.historyProfits.shift();
            }
        });

        refreshAppEngine();
        alert("📊 記帳成功！今日的最新股價與再平衡資產狀態已成功寫入歷史折線圖！");
    }

    function resetToSystemDefault() {
        if(confirm("確定要重置回復到範例初始狀態嗎？這會覆蓋您目前的紀錄。")) {
            state = JSON.parse(JSON.stringify(initialDefaultState));
            document.getElementById('direct-cash-input').value = state.cash;
            document.getElementById('direct-debt-input').value = state.debt;
            document.getElementById('target-ratio-select').value = "9:1";
            toggleCustomRatioInput();
            refreshAppEngine();
        }
    }

    window.onload = appInit;
</script>

